 # This is the network config written by 'subiquity'
network:
  ethernets:
    eth0:
      dhcp4: false
      addresses:
        - 192.168.254.9/24
      routes:
        - to: default
         via: 192.168.254.254
      nameservers:
        addresses: [8.8.8.8, 8.8.4.4]
  version: 2
  
# Apply changes using:
sudo netplan apply