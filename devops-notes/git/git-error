
# Connect to the remote Git repository and list the references 
# (branches, tags, and commit hashes) without cloning the repository
git ls-remote https://github.com/lherbeng/RKE2.git

Error:
fatal: unable to access 'https://github.com/lherbeng/RKE2.git/': Could not resolve host: github.com

Solution: 

Edit /etc/netplan/00-installer-config.yaml and change gateway4 from 192.168.1.1 to 192.168.254.254

# This is the network config written by 'subiquity'
network:
  ethernets:
    eth0:
      dhcp4: false
      addresses:
        - 192.168.254.9/24
      gateway4: 192.168.1.1
      nameservers:
        addresses: [8.8.8.8, 8.8.4.4]
  version: 2
  
